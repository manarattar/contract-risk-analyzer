# v2 ignores legacy OPENAI_*, MOCK_MODE and database settings.
# No automatic schema changes: initialize the separate v2 datastore explicitly.
REVIEW_MODE=demo
REVIEW_DATA_DIR=./data/review-v2
# Operator-provisioned random tokens (at least 32 characters); store SHA-256 only.
# JSON list fields: id, workspace_id, role (viewer/reviewer/owner), token_sha256.
# Empty list denies all document access. Never commit a real token or hash list.
REVIEW_PRINCIPALS_JSON=[]
REVIEW_UPLOAD_ENABLED=false
REVIEW_PAGE_RENDERING_ENABLED=false
REVIEW_PARSER_ISOLATION_APPROVED=false
REVIEW_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
REVIEW_PRIVACY_DESCRIPTION=Confidential uploads are not approved. Use the synthetic sample.
REVIEW_RETENTION_DAYS=30
REVIEW_BACKUP_RETENTION=Not verified; active deletion does not erase external backups.
REVIEW_PROVIDER_NAME=Not configured
REVIEW_PROVIDER_RETENTION=Not verified; do not submit confidential documents.
REVIEW_PROVIDER_HANDLING_APPROVED=false
REVIEW_EVALUATION_APPROVED=false
REVIEW_EVALUATION_REPORT=
# Live mode also needs these values; default compose worker has no network.
REVIEW_API_KEY=
REVIEW_MODEL=
REVIEW_API_BASE_URL=https://api.openai.com/v1
