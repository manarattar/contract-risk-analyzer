# Local defaults
DATABASE_URL=sqlite:///./data/contracts.db
STORAGE_BACKEND=local
VECTOR_BACKEND=chroma
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini
# Set false for GPT-5-family Azure deployments, which reject custom temperature
LLM_USE_TEMPERATURE=true
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
MOCK_MODE=false
CORS_ORIGINS=*
# Azure Blob Storage: use managed identity unless a key is supplied
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=uploads
AZURE_STORAGE_KEY=
# Azure AI Search: shared index with id, doc_id, text, content_vector fields
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=contract-chunks
AZURE_SEARCH_KEY=
# Azure OpenAI: chat and embedding deployment names; managed identity unless key supplied
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_API_KEY=
